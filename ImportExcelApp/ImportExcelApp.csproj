<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- switch to .NET Framework 4.8 and enable latest C# features -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- executable output so dotnet run / msbuild produces an .exe -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- OleDb is part of the framework on net48, no package needed -->
    <PackageReference Include="System.Text.Json" Version="7.0.2" />
  </ItemGroup>

</Project>
